# Copy this file to .env and fill in the real values
# NEVER commit .env to git

SECRET_KEY=change-this-to-a-long-random-string

# NVR / Camera credentials
NVR_URL=http://YOUR_NVR_IP:PORT
NVR_USER=admin
NVR_PASS=your-nvr-password

# Database (leave empty to use local SQLite)
# DATABASE_URL=sqlite:////absolute/path/to/z_padel.db

# Flask environment: development or production
FLASK_ENV=production
